# Terraform state (can contain secrets, never commit)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# SSH keys — never commit private (or public) keys
vpc-private-key
vpc-private-key.pub
*.pem
*.ppk

# Crash logs
crash.log
crash.*.log

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/
