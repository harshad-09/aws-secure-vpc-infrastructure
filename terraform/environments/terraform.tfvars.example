# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored on purpose - don't commit it if it ever
# contains anything sensitive.

project_name     = "prod"
aws_region       = "us-east-1"
key_pair_name    = "your-ec2-key-pair-name"
ssh_allowed_cidr = "YOUR_IP/32"   # lock this down - don't leave it 0.0.0.0/0
